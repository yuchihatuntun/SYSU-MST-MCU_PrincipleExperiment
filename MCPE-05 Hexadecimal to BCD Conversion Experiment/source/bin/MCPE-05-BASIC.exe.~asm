CODE SEGMENT
ASSUME CS:CODE
START:
MOV  AX, CS           ; 设置 DS 指向代码段（关键修正）
MOV  DS, AX

MOV  DX, 0000H        ; 清除 DX
MOV  AX, 65535        ; 测试值 AX=65535 (0FFFFH)

; --- 拆分万位 (6) ---
MOV  BX, 10000        ; 除数 = 10000
DIV  BX               ; AX / BX → 商(AL)=万位, 余数(DX)
MOV  [0200H], AL      ; 直接写入内存地址 0200H

; --- 拆分千位 (5) ---
MOV  AX, DX           ; 余数 → AX
MOV  DX, 0000H        ; 重置 DX
MOV  BX, 1000         ; 除数 = 1000
DIV  BX               ; AX / BX → 商(AL)=千位, 余数(DX)
MOV  [0201H], AL      ; 直接写入内存地址 0201H

; --- 拆分百位 (5) ---
MOV  AX, DX           ; 余数 → AX
MOV  DX, 0000H        ; 重置 DX
MOV  BX, 100          ; 除数 = 100
DIV  BX               ; AX / BX → 商(AL)=百位, 余数(DX)
MOV  [0202H], AL      ; 直接写入内存地址 0202H

; --- 拆分十位 (3) ---
MOV  AX, DX           ; 余数 → AX
MOV  DX, 0000H        ; 重置 DX
MOV  BX, 10           ; 除数 = 10
DIV  BX               ; AX / BX → 商(AL)=十位, 余数(DX)
MOV  [0203H], AL      ; 直接写入内存地址 0203H

; --- 拆分个位 (5) ---
MOV  [0204H], DL      ; 余数(DL)=个位 → 内存地址 0204H

JMP  $                ; 停机指令
CODE ENDS
END START

