[  38]        :                                       
[  39]    0030:                                       OUTER_LOOP:
[  40]    0030: BB 00 00                              MOV     BX, 0                   ; 交换标志：0=未交换
[  41]    0033: BE 00 00                              MOV     SI, 0                   ; 内层循环索引从0开始
[  42]        :                                       
[  43]    0036:                                       INNER_LOOP:
[  44]        :                                       ; 边界检查：SI+1 是否越界
[  45]    0036: 8B C6                                 MOV     AX, SI
[  46]    0038: 40                                    INC     AX
[  47]    0039: 3D 06 00                              CMP     AX, 6                   ; 比较索引是否超出数组边界
[  48]    003C: 73 1C                                 JAE     END_INNER_LOOP          ; 如果SI+1 >= 数组长度，结束内层循环
[  49]        :                                       
[  50]        :                                       ; 读取相邻元素进行比较
[  51]    003E: 8A 84 00 02                           MOV     AL, [0200H + SI]        ; AL = 当前元素
[  52]    0042: 8A A4 01 02                           MOV     AH, [0200H + SI + 1]    ; AH = 下一个元素
[  53]        :                                       
[  54]        :                                       ; 比较并决定是否交换
[  55]    0046: 3A C4                                 CMP     AL, AH
[  56]    0048: 76 0D                                 JBE     NO_SWAP                 ; 如果AL <= AH，不需要交换（升序排序）
[  57]        :                                       
[  58]        :                                       ; 执行交换
[  59]    004A: 86 C4                                 XCHG    AL, AH
[  60]    004C: 88 84 00 02                           MOV     [0200H + SI], AL        ; 存回当前元素
[  61]    0050: 88 A4 01 02                           MOV     [0200H + SI + 1], AH    ; 存回下一个元素
