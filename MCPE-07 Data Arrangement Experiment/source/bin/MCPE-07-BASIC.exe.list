[  28]        :                                       ; 冒泡排序
[  29]        :                                       ; 输入：DS:[0200H]开始的6个字节
[  30]        :                                       ; 输出：原地排序后的6个字节
[  31]        :                                       ;==============================================
[  32]    0027:                                       BUBBLE_SORT PROC NEAR
[  33]    0027: B9 06 00                              MOV     CX, 6                   ; 数组长度
[  34]    002A: 83 F9 01                              CMP     CX, 1                   ; 如果长度<=1，直接返回
[  35]    002D: 76 32                                 JBE     SORT_DONE
[  36]        :                                       
