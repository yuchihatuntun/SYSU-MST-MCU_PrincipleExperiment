CODE SEGMENT
ASSUME CS:CODE
START:
MOV  AX, CS
MOV  DS, AX

MOV  CX, 100
XOR  AX, AX          ; 累加器清零
MOV  BX, 1           ; 当前加数

ADD_LOOP:
ADD  AX, BX          ; AX = AX + BX
INC  BX              ; BX++
LOOP ADD_LOOP

; 存储结果到显式地址 0200H（低字节）和 0201H（高字节）
MOV  [0200H], AL
MOV  [0201H], AH

; 验证结果是否为5050
CMP  AX, 5050
JNE  ERROR

JMP  $

ERROR:
MOV  BX, 0FFFFH         ; 错误码
JMP  $

CODE ENDS
END START



